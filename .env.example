# Copier en .env et compléter. Le fichier .env n'est jamais versionné.

# --- Base de données ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=localhost
# 5433 et non 5432 : évite tout conflit avec un PostgreSQL déjà installé sur la machine
POSTGRES_PORT=5433

# --- Modèles ---
MODELE_EMBEDDING=intfloat/multilingual-e5-large
MODELE_RERANKER=BAAI/bge-reranker-v2-m3

# --- Génération ---
# fournisseur : anthropic | openai | ollama
# « openai » désigne tout service exposant l'API de complétion de chat d'OpenAI ; le
# prestataire se choisit par LLM_BASE_URL, sans toucher au code.
LLM_FOURNISSEUR=openai

# Exemples d'URL de base, à associer au modèle correspondant :
#   Groq      https://api.groq.com/openai/v1        openai/gpt-oss-120b
#   Mistral   https://api.mistral.ai/v1             mistral-small-latest
#   OpenRouter https://openrouter.ai/api/v1         meta-llama/llama-3.3-70b-instruct:free
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODELE=openai/gpt-oss-120b
LLM_CLE_API=

# Utilisé seulement si LLM_FOURNISSEUR=anthropic
ANTHROPIC_API_KEY=

# Utilisé seulement si LLM_FOURNISSEUR=ollama
OLLAMA_URL=http://localhost:11434

# --- Recherche ---
TOP_K_CANDIDATS=30
TOP_K_FINAL=5
RRF_K=60
