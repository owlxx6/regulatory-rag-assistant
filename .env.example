# Copier en .env et compléter. Le fichier .env n'est jamais versionné.

# --- Base de données ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_HOST=localhost
# 5433 et non 5432 : évite tout conflit avec un PostgreSQL déjà installé sur la machine
POSTGRES_PORT=5433

# --- Modèles ---
MODELE_EMBEDDING=intfloat/multilingual-e5-large
MODELE_RERANKER=BAAI/bge-reranker-v2-m3

# --- Génération ---
# fournisseur : anthropic | ollama
LLM_FOURNISSEUR=anthropic
LLM_MODELE=claude-sonnet-5
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Recherche ---
TOP_K_CANDIDATS=30
TOP_K_FINAL=5
RRF_K=60
